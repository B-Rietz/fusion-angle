#!/bin/bash
set -euo pipefail

# Layer 2: deterministic browser tests. Bundles the
# client into $TMPDIR (any tree), then runs
# tests/browser/*.test.ts, each test against an
# in-process origin of its own on the memory backend.
# Needs Chrome: CHROME (binary) or CHROME_DEBUG_URL (a
# running Chrome's browser WebSocket URL).

BIN="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(cd "$BIN/.." && pwd)"
cd "$ROOT"

# shellcheck source=build-lib
source "$BIN/build-lib"

if [ -z "${CHROME_DEBUG_URL:-}" ]; then
    CHROME="${CHROME:-/Applications/Google Chrome.app}"
    CHROME="${CHROME%/}"
    if [ -d "$CHROME" ]; then
        CHROME="$CHROME/Contents/MacOS/Google Chrome"
    fi
    if [ ! -x "$CHROME" ]; then
        echo "Error: Chrome not found; set CHROME to" \
            "the binary or CHROME_DEBUG_URL to a" \
            "running Chrome" >&2
        exit 1
    fi
    export CHROME
fi

export JWT_HMAC_SIGNING_KEY="${JWT_HMAC_SIGNING_KEY:-test-hmac-signing-key}"

# One directory holds the run: the bundle, and every temp
# directory the suite makes, each Chrome's profile among
# them. The trap removes it whole, so an interrupted run
# leaves no profile behind.
RUN_DIR="$(mktemp -d "${TMPDIR:-/tmp}/fusion-browser.XXXXXX")"
trap 'rm -rf "$RUN_DIR"' EXIT
BUNDLE="$RUN_DIR/site"
bundle_client "$BUNDLE" > /dev/null
export FUSION_ANGLE_STATIC_ROOT="$BUNDLE"
mkdir "$RUN_DIR/tmp"

# A launched Chrome is one per file, so the files run
# together, four at a time. The operator often runs
# other threads beside a suite, so it takes four workers
# and never a worker per CPU, where each worker also
# drives a Chrome of several processes. A DENO_JOBS the
# shell exports wins. An attached Chrome is one browser
# for every file, so those files run one at a time.
BROWSER_FILE_WORKERS=4
SCHEDULE=''
if [ -z "${CHROME_DEBUG_URL:-}" ]; then
    SCHEDULE='--parallel'
    export DENO_JOBS="${DENO_JOBS:-$BROWSER_FILE_WORKERS}"
fi

# Per-test bound lives in tests/browser/fixtures.ts
# (withTimeout). deno test has no per-test timeout flag.
# --allow-env is unscoped: Chrome spawn copies the env bag.
# Resources only, no --sanitize-ops: useBrowser() opens the
# CDP WebSocket once per file in Deno.test.beforeAll, so its
# pending receive always crosses a test boundary and the ops
# sanitizer fails every test in the file. Closing the socket
# per test means one Chrome per test, against the one Chrome
# per file this suite is built on.
# worker-name-prefix.ts: files run together are workers in
# one process, where BroadcastChannel and navigator.locks
# name process-wide buses and locks. The prefix gives each
# worker names of its own, as it does for ./test.
TMPDIR="$RUN_DIR/tmp" TZ=UTC \
    deno test --frozen --no-check $SCHEDULE \
    --sanitize-resources \
    --allow-env --allow-read --allow-write \
    --allow-net --allow-run \
    --preload ./tests/hmac-test-key.ts \
    --preload ./tests/local-storage-stub.ts \
    --preload ./tests/worker-name-prefix.ts \
    tests/browser/*.test.ts
