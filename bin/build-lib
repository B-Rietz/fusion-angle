#!/bin/bash
# Sourced from repo root after the caller `cd "$ROOT"`.
# Not a command. bundle_client composes the pages
# and bundles the client into DEST; commit_log reads
# the commit log a build embeds, and fetched_commit
# reads it for a build without a checkout;
# ./bin/build owns the executable and the ZIP, and
# asks bin/clean-tree-lib about the tree.

# Fail when the artifact is empty or absent; report its
# size otherwise — one voice for every emitted artifact.
emitted() {
    local label="$1" artifact="$2"
    local name rel prefix
    name=$(basename "$artifact")
    if [ ! -s "$artifact" ]; then
        echo "ERROR: $name is empty or missing" >&2
        exit 1
    fi
    prefix="${dest:-${BUILD_DIR:-}}"
    if [ -n "$prefix" ]; then
        rel="${artifact#"$prefix"/}"
    else
        rel="$name"
    fi
    echo "$label: $rel" \
        "($(wc -c < "$artifact" | xargs) bytes)"
}

bundle_client() {
    local dest="$1"
    mkdir -p "$dest/assets"
    deno bundle --frozen \
        --platform browser \
        --format esm \
        --code-splitting \
        --minify \
        --keep-names \
        --outdir "$dest/assets" \
        web-app/app/server-core.ts

    if [ -f "$dest/assets/server-core.js" ]; then
        mv "$dest/assets/server-core.js" \
            "$dest/assets/app.js"
    fi

    emitted "Server bundle created" \
        "$dest/assets/app.js"

    # Pre-app bootstrap scripts: extracted from former inline
    # <script> blocks so the page can run with a strict
    # Content-Security-Policy (script-src 'self').
    deno bundle --frozen \
        --platform browser \
        --format iife \
        --minify \
        -o "$dest/assets/sidebar-restore.js" \
        web-app/app/sidebar-restore.ts

    emitted "Bundle created" "$dest/assets/sidebar-restore.js"

    deno bundle --frozen \
        --platform browser \
        --format iife \
        --minify \
        -o "$dest/assets/root-redirect.js" \
        web-app/app/root-redirect.ts

    emitted "Bundle created" "$dest/assets/root-redirect.js"

    deno bundle --frozen \
        --platform browser \
        --format iife \
        --minify \
        -o "$dest/assets/status-refresh.js" \
        web-app/app/status-refresh.ts

    emitted "Bundle created" "$dest/assets/status-refresh.js"

    cp web-app/assets/*.woff2 "$dest/assets/"
    cp web-app/assets/favicon.ico "$dest/assets/"
    cp web-app/assets/favicon.svg "$dest/assets/"
    cp web-app/assets/mark.png "$dest/assets/"

    cat web-app/app/styles/tokens.css \
        web-app/app/styles/fonts.css \
        web-app/app/styles/palette.css \
        web-app/app/styles/base.css \
        web-app/app/styles/components-*.css \
        web-app/app/styles/layout.css \
        web-app/app/styles/utilities.css \
        web-app/app/styles/responsive.css \
        web-app/app/styles/command-palette.css \
        > "$dest/styles.concat.css"

    deno run --frozen --allow-read \
        --allow-write="$dest" \
        web-app/app/hash-static.ts "$dest"

    deno bundle --frozen --minify \
        --external '*.woff2' \
        -o "$dest/assets/styles.css" \
        "$dest/styles.concat.css"

    rm -f "$dest/styles.concat.css"

    emitted "Styles created" "$dest/assets/styles.css"

    for f in web-app/app/styles/pages-*.css; do
        [ -f "$f" ] || continue
        name=$(basename "$f" .css)
        deno bundle --frozen --minify \
            --external '*.woff2' \
            --external '*.png' \
            -o "$dest/assets/$name.css" "$f"
        emitted "Styles created" "$dest/assets/$name.css"
    done
    cp web-app/index.html "$dest/"

    deno run --frozen --allow-read \
        --allow-write="$dest" \
        web-app/app/hash-static.ts "$dest"

    deno run --frozen --allow-read \
        --allow-write="$dest" \
        web-app/app/compose.ts "$dest"

    deno run --frozen --allow-read \
        --allow-write="$dest" \
        web-app/app/hash-static.ts --gzip "$dest"
}

# Print the commit log /status reads, from the repository
# at DIR: REV's line, then REV's first-parent line from
# REV itself, newest first, one `%H %ct %s` line each;
# server/git-sha.ts drops REV and keeps ten.
commit_log() {
    local dir="$1" rev="$2"
    git -C "$dir" log -1 --format='%H %ct %s' "$rev" \
        && git -C "$dir" log --first-parent -n 11 \
            --format='%H %ct %s' "$rev"
}

# Print the commit log of DIR's HEAD as one line of
# base64, for a local Docker build: the image gets a
# worktree's .git, which names a directory on the host,
# so the build cannot read the log itself.
host_commit_log_base64() {
    local dir="$1" log
    log=$(commit_log "$dir" HEAD) || return 1
    printf '%s' "$log" | base64 | tr -d '\n'
}

# Print the log host_commit_log_base64 encoded; print
# nothing and fail unless its first word is a 40-hex sha.
decoded_commit_log() {
    local log sha
    log=$(printf '%s' "$1" | base64 -d 2>/dev/null) \
        || return 1
    sha=${log%% *}
    case $sha in
        ''|*[!0-9a-f]*) return 1 ;;
    esac
    [ "${#sha}" -eq 40 ] || return 1
    printf '%s\n' "$log"
}

# Print SHA's commit log, as fetched from URL with no
# credential; print nothing and fail when any git call
# fails or the fetch answers another commit: a caller
# under `if !` runs with set -e off. The scratch
# repository sits under TMPDIR, outside the source tree,
# and holds commit objects alone. The shallow fetch keeps
# the history the log reads; a commit past it is absent.
fetched_commit() {
    local url="$1" sha="$2" scratch fetched log
    scratch=$(mktemp -d \
        "${TMPDIR:-/tmp}/fusion-commit.XXXXXX")
    if ! git init --quiet "$scratch" \
        || ! GIT_TERMINAL_PROMPT=0 git -C "$scratch" \
            -c http.lowSpeedLimit=1000 \
            -c http.lowSpeedTime=30 \
            fetch --quiet --depth 32 --filter=tree:0 \
            "$url" "$sha" >&2 \
        || ! fetched=$(git -C "$scratch" rev-parse \
            FETCH_HEAD) \
        || ! log=$(commit_log "$scratch" FETCH_HEAD); then
        rm -rf "$scratch"
        return 1
    fi
    rm -rf "$scratch"
    if [ "$fetched" != "$sha" ]; then
        return 1
    fi
    printf '%s\n' "$log"
}
