#!/bin/bash
set -euo pipefail

usage() {
    cat <<'USAGE'
Usage: ./test [memory]
       ./test check
       ./test lint
       ./test schema
       ./test api-docs
       ./test postgres
       ./test browser
       ./test validate [--syntax]
       ./test validate browser
       ./test validate postgres
USAGE
}

ROOT="$(cd "$(dirname "$0")" && pwd)"
cd "$ROOT"
# shellcheck source=bin/clean-tree-lib
. "$ROOT/bin/clean-tree-lib"
# shellcheck source=bin/sha-result-cache-lib
. "$ROOT/bin/sha-result-cache-lib"
# shellcheck source=bin/duration-lib
. "$ROOT/bin/duration-lib"

# Instants render in LOCAL time, so date-formatting
# output shifts with the runner's zone — a false prophet
# on a non-UTC machine. Pin UTC for the main suite
# (deterministic), then verify the instant-vs-calendar
# distinction under a fixed offset zone in tests/tz/
# (Honolulu, UTC-10, no DST). The tests/*.test.ts glob
# is non-recursive, so it excludes tests/tz/.
#
# --no-check: deno check covers tests/ in ./test check;
# checking again at run time buys nothing.
# Permissions, named: env (signing key, TZ, POSTGRES_URL
# skips), read (fixtures, scripts, source walkers),
# write (temp dirs for the HTTP tests), net (127.0.0.1
# listeners), run (the metafile test now spawns deno;
# serve, develop, deploy, test, measure, and
# postgres-gun CLI pins spawn those scripts;
# the build-lib and duration-lib pins source their
# libraries through sh, and the result-cache pins theirs
# through /bin/bash, the shell its callers name; /status
# reads git).
#
# Workers: four per pass, not deno's one per CPU. The
# operator's machine is usually running other work
# beside the suite. DENO_JOBS already in the environment
# is deno's own knob and wins, for one run that may have
# the machine. A DENO_JOBS that is no positive count is
# refused: deno would read it as one worker and say
# nothing. The count goes to the two passes alone, never
# exported to the steps and suites that follow them.
MEMORY_SUITE_WORKERS=4

run_memory() {
    local workers="${DENO_JOBS:-$MEMORY_SUITE_WORKERS}"
    if ! [[ "$workers" =~ ^[1-9][0-9]*$ ]]; then
        echo "Error: DENO_JOBS is no worker count:" \
            "'$workers'" >&2
        exit 1
    fi
    JWT_HMAC_SIGNING_KEY="${JWT_HMAC_SIGNING_KEY:-test-hmac-signing-key}"
    export JWT_HMAC_SIGNING_KEY
    ALLOW_RUN=deno,./bin/serve,./deploy,sh,./test,git
    ALLOW_RUN="$ALLOW_RUN,./bin/postgres-wipe"
    ALLOW_RUN="$ALLOW_RUN,./bin/postgres-seed"
    ALLOW_RUN="$ALLOW_RUN,./bin/measure"
    ALLOW_RUN="$ALLOW_RUN,./bin/develop"
    ALLOW_RUN="$ALLOW_RUN,./bin/worktree-add"
    ALLOW_RUN="$ALLOW_RUN,/bin/bash"
    DENO_TEST=(
        deno test --frozen --no-check
        --sanitize-ops --sanitize-resources
        --allow-env --allow-read --allow-write
        --allow-net
        --allow-run="$ALLOW_RUN"
        --preload ./tests/hmac-test-key.ts
        --preload ./tests/local-storage-stub.ts
        --preload ./tests/session-storage-stub.ts
        --preload ./tests/worker-name-prefix.ts
    )
    DENO_JOBS="$workers" TZ=UTC "${DENO_TEST[@]}" --parallel \
        tests/*.test.ts
    DENO_JOBS="$workers" TZ=Pacific/Honolulu \
        "${DENO_TEST[@]}" --parallel tests/tz/*.test.ts
}

run_check() {
    deno --version
    deno check --frozen api client shared server tests web-app
}

run_lint() {
    AWK_LINT='length > 78 {
        printf "%s:%d: %d chars\n", FILENAME, FNR, length
    }'
    LONG_LINES=$( {
        find api client web-app tests shared server -type f \
            \( -name '*.ts' -o -name '*.html' \
               -o -name '*.css' \) \
            ! -path 'web-app/app/compose.ts' \
            -exec awk "$AWK_LINT" {} +
        awk "$AWK_LINT" test deploy \
            bin/build bin/build-lib bin/serve \
            bin/develop \
            bin/test-postgres bin/test-browser \
            bin/generate-schema-svg \
            bin/generate-api-documentation \
            bin/measure bin/postgres-wipe \
            bin/postgres-lib bin/postgres-seed \
            bin/compose-lib bin/worktree-add \
            bin/sha-result-cache-lib \
            bin/duration-lib \
            bin/clean-tree-lib \
            deno.json Dockerfile compose.yaml \
            .dockerignore
    } )

    if [ -n "$LONG_LINES" ]; then
        echo "Error: lines exceed 78 characters:" >&2
        echo "$LONG_LINES" >&2
        exit 1
    fi

    # Reject the `org` abbreviation in identifiers;
    # use `organization`. Prose, URLs (w3.org), and
    # CSS class names may keep the short form.
    ORG_ABBREV=$(
        find api client web-app tests shared server -type f \
            \( -name '*.ts' -o -name '*.html' \
               -o -name '*.css' \) \
            ! -path 'web-app/app/compose.ts' -print0 \
        | xargs -0 perl -ne '
            close ARGV if eof;
            print "$ARGV:$.: $_"
                if /org[A-Z]|[a-z]Org([A-Z]|\b)|\bOrg[A-Z]/
                || /[a-z]Orgs([A-Z]|\b)|\bOrgs[A-Z]/
                || /_ORG(_|[0-9]|\b)|\bORG(_|[0-9])/;
        '
    )

    if [ -n "$ORG_ABBREV" ]; then
        echo "Error: 'org' abbreviation in identifiers:" >&2
        echo "$ORG_ABBREV" >&2
        exit 1
    fi

    # Reject the vocabulary of the retired browser-resident
    # storage tiers. `localStorage` alone is legal (UI
    # preferences); its backend/tier compounds are not.
    PATTERN='indexeddb|IDBTransaction|non-IDB|\bIDB\b'
    PATTERN="$PATTERN|LocalStorageBackend"
    PATTERN="$PATTERN|localStorage (backend|tier|simulated|demo)"
    PATTERN="$PATTERN|simulated (backend|tier)s?"
    PATTERN="$PATTERN|object stores?|\bPhase B\b|auto-?commit"
    PATTERN="$PATTERN|in-browser data|browser[ -]ZIP"
    RETIRED_VOCAB=$(
        {
            find api client shared server tests web-app/app \
                -type f \
                \( -name '*.ts' -o -name '*.html' \
                   -o -name '*.css' \) -print0 \
            | xargs -0 grep -nEi "$PATTERN" \
                || true
            find . -maxdepth 1 -type f -name '*.md' \
                -exec grep -nEi "$PATTERN" {} + \
                || true
        } || true
    )

    if [ -n "$RETIRED_VOCAB" ]; then
        echo "Error: retired storage-tier vocabulary:" >&2
        echo "$RETIRED_VOCAB" >&2
        exit 1
    fi

    # Every api/ read is a collection or a document (spec
    # 2026-09-15 exact-read folds § 7): the whole-plane read
    # is not on the derive face. tests/ may still count the
    # plane through the concrete store.
    WHOLE_PLANE=$(
        grep -rn 'messagePairs\.getAll(' api || true
    )

    if [ -n "$WHOLE_PLANE" ]; then
        echo "Error: whole-plane messagePairs.getAll( in api/:" >&2
        echo "$WHOLE_PLANE" >&2
        exit 1
    fi

    # Later work has one home (run-four remediation §10):
    # the section lives in TODO.md and nowhere else, and no
    # other root doc defers work in prose. Rows that POINT
    # at TODO.md are the sanctioned exception.
    LATER_HOME_FAIL=
    if [ "$(grep -c '^## Later work' ARCHITECTURE.md)" \
        != "0" ]; then
        LATER_HOME_FAIL="${LATER_HOME_FAIL}\
ARCHITECTURE.md: '## Later work' count must be 0
"
    fi
    if [ "$(grep -c '^## KNOWN seams' ARCHITECTURE.md)" \
        != "1" ]; then
        LATER_HOME_FAIL="${LATER_HOME_FAIL}\
ARCHITECTURE.md: '## KNOWN seams' count must be 1
"
    fi
    if [ "$(grep -c '^## Critical product path' TODO.md)" \
        != "1" ]; then
        LATER_HOME_FAIL="${LATER_HOME_FAIL}\
TODO.md: '## Critical product path' count must be 1
"
    fi
    LATER_PATTERN='later work|\(later\)|not built'
    LATER_PATTERN="$LATER_PATTERN|coming soon"
    LATER_PATTERN="$LATER_PATTERN|later session"
    LATER_PATTERN="$LATER_PATTERN|will be added when"
    DEFERRAL_PROSE=$(
        find . -maxdepth 1 -type f -name '*.md' \
            ! -name 'TODO.md' ! -name 'TEST-PLAN.md' \
            -exec grep -nEi "$LATER_PATTERN" {} + \
            2>/dev/null \
        | grep -v 'TODO.md' || true
    )

    if [ -n "${LATER_HOME_FAIL}${DEFERRAL_PROSE}" ]; then
        echo "Error: later work must live in TODO.md:" >&2
        printf '%s' "${LATER_HOME_FAIL}" >&2
        if [ -n "${DEFERRAL_PROSE}" ]; then
            echo "${DEFERRAL_PROSE}" >&2
        fi
        exit 1
    fi

    # Every tests/… path TEST-PLAN.md cites must exist.
    # Paths, not test names: a name is the audit's
    # judgment, a path is what rots when a file is
    # renamed or deleted. The trailing `|| true` is
    # this file's idiom for a grep that may legitimately
    # match nothing: under `set -euo pipefail` a
    # no-match grep would otherwise kill the whole
    # script at this assignment, silently and with no
    # diagnostic.
    MISSING_PINS=$(
        grep -oE 'tests/[A-Za-z0-9._/-]+\.test\.ts' \
            TEST-PLAN.md \
        | sort -u \
        | while read -r PIN_PATH; do
            [ -f "$PIN_PATH" ] || echo "  ${PIN_PATH}"
        done || true
    )

    if [ -n "$MISSING_PINS" ]; then
        echo "Error: TEST-PLAN.md cites a missing test:" >&2
        echo "$MISSING_PINS" >&2
        exit 1
    fi
}

run_schema() {
    ./bin/generate-schema-svg --check
}

run_api_docs() {
    ./bin/generate-api-documentation --check
}

# A step that passed on this SHA replays instead of
# running again (bin/sha-result-cache-lib), so a validated
# SHA validates again at once. check and schema repeat in
# under a second and always run. The Postgres and browser
# suites ask at their own doors, in the scripts this one
# execs.
#
# With POSTGRES_URL set the memory suite also runs its
# Postgres files against that database, and no SHA names
# a database.
#
# Every step is timed where it really runs
# (bin/duration-lib). The timer goes inside the ask,
# after its `--`, so a replay is never a sample; check
# and schema are never asked, so each is timed as it
# stands.
replay_or_run_memory() {
    if [ -n "${POSTGRES_URL:-}" ]; then
        timed './test memory' run_memory
    else
        replay_or_run memory -- timed './test memory' run_memory
    fi
}

replay_or_run_lint() {
    replay_or_run lint -- timed './test lint' run_lint
}

replay_or_run_api_docs() {
    replay_or_run api-docs -- timed './test api-docs' run_api_docs
}

run_validate() {
    timed './test check' run_check
    replay_or_run_memory
    replay_or_run_lint
    timed './test schema' run_schema
    replay_or_run_api_docs
}

# Every form refuses a dirty tree (bin/clean-tree-lib),
# in its own arm: after that arm has read its arguments,
# so --help and a usage error answer on any tree, and
# before its step. The two suites this script execs are
# asked again at their own doors, where they are also run
# directly.
case "${1:-memory}" in
    --help|-h)
        usage
        exit 0
        ;;
    memory)
        if [ $# -gt 1 ]; then
            echo "Error: unexpected argument: $2" >&2
            usage >&2
            exit 1
        fi
        require_clean_tree
        replay_or_run_memory
        ;;
    check|lint|schema|api-docs|postgres|browser)
        if [ $# -ne 1 ]; then
            echo "Error: unexpected argument" >&2
            usage >&2
            exit 1
        fi
        require_clean_tree
        case "$1" in
            check) timed './test check' run_check ;;
            lint) replay_or_run_lint ;;
            schema) timed './test schema' run_schema ;;
            api-docs) replay_or_run_api_docs ;;
            postgres) exec "$ROOT/bin/test-postgres" ;;
            browser) exec "$ROOT/bin/test-browser" ;;
        esac
        ;;
    validate)
        shift
        if [ $# -eq 0 ]; then
            require_clean_tree
            run_validate
        elif [ $# -eq 1 ] && [ "$1" = "--syntax" ]; then
            # Check only: it asks nothing of the
            # result cache and records nothing in it.
            require_clean_tree
            timed './test check' run_check
        elif [ $# -eq 1 ] && [ "$1" = "browser" ]; then
            require_clean_tree
            run_validate
            exec "$ROOT/bin/test-browser"
        elif [ $# -eq 1 ] && [ "$1" = "postgres" ]; then
            require_clean_tree
            run_validate
            exec "$ROOT/bin/test-postgres"
        else
            echo "Error: unknown suite" >&2
            usage >&2
            exit 1
        fi
        ;;
    *)
        echo "Error: unknown suite: $1" >&2
        usage >&2
        exit 1
        ;;
esac
